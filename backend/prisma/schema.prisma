// SmartStay ERP - Prisma Database Schema
// PostgreSQL Relational Mapping for Hotel Room Management & Analytics

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  RECEPTIONIST
  HOUSEKEEPING
  GUEST
}

enum RoomType {
  SINGLE
  DOUBLE
  DELUXE
  SUITE
}

enum RoomStatus {
  AVAILABLE
  BOOKED
  OCCUPIED
  CLEANING
  MAINTENANCE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  NET_BANKING
  SIMULATED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model User {
  id                String            @id @default(uuid())
  email             String            @unique
  passwordHash      String
  name              String
  role              Role              @default(GUEST)
  phone             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  bookings          Booking[]
  housekeepingTasks HousekeepingLog[] @relation("AssignedHousekeeping")
  activityLogs      ActivityLog[]

  @@map("users")
}

model Room {
  id                String            @id @default(uuid())
  roomNumber        String            @unique
  floor             Int               @default(1)
  type              RoomType          @default(SINGLE)
  pricePerNight     Decimal           @db.Decimal(10, 2)
  capacity          Int               @default(2)
  amenities         String[]          @default([])
  status            RoomStatus        @default(AVAILABLE)
  description       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  bookings          Booking[]
  housekeepingLogs  HousekeepingLog[]

  @@map("rooms")
}

model Booking {
  id                String            @id @default(uuid())
  bookingNumber     String            @unique
  guestId           String
  roomId            String
  checkInDate       DateTime
  checkOutDate      DateTime
  totalNights       Int
  baseAmount        Decimal           @db.Decimal(10, 2)
  addOnAmount       Decimal           @default(0.00) @db.Decimal(10, 2)
  gstAmount         Decimal           @default(0.00) @db.Decimal(10, 2)
  totalAmount       Decimal           @db.Decimal(10, 2)
  status            BookingStatus     @default(CONFIRMED)
  specialRequests   String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  guest             User              @relation(fields: [guestId], references: [id], onDelete: Restrict)
  room              Room              @relation(fields: [roomId], references: [id], onDelete: Restrict)
  invoice           Invoice?
  payments          Payment[]

  @@index([roomId, checkInDate, checkOutDate])
  @@index([guestId])
  @@map("bookings")
}

model Invoice {
  id                String            @id @default(uuid())
  invoiceNumber     String            @unique
  bookingId         String            @unique
  guestName         String
  roomNumber        String
  checkInDate       DateTime
  checkOutDate      DateTime
  subTotal          Decimal           @db.Decimal(10, 2)
  gstRate           Decimal           @default(12.00) @db.Decimal(5, 2) // e.g. 12% or 18% GST
  gstAmount         Decimal           @db.Decimal(10, 2)
  addOnTotal        Decimal           @default(0.00) @db.Decimal(10, 2)
  grandTotal        Decimal           @db.Decimal(10, 2)
  itemizedSummary   Json?             // Breakdown of room stay + add-ons + tax
  status            PaymentStatus     @default(PENDING)
  issuedAt          DateTime          @default(now())

  booking           Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payments          Payment[]

  @@map("invoices")
}

model Payment {
  id                String            @id @default(uuid())
  bookingId         String
  invoiceId         String?
  amount            Decimal           @db.Decimal(10, 2)
  paymentMethod     PaymentMethod     @default(SIMULATED)
  paymentStatus     PaymentStatus     @default(COMPLETED)
  transactionRef    String            @unique
  paidAt            DateTime          @default(now())

  booking           Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  invoice           Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@map("payments")
}

model HousekeepingLog {
  id                String            @id @default(uuid())
  roomId            String
  assignedToId      String?
  status            TaskStatus        @default(PENDING)
  taskType          String            @default("CLEANING") // CLEANING, REPAIR, INSPECTION
  notes             String?
  reportedAt        DateTime          @default(now())
  completedAt       DateTime?

  room              Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  assignedTo        User?             @relation("AssignedHousekeeping", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@map("housekeeping_logs")
}

model ActivityLog {
  id                String            @id @default(uuid())
  userId            String?
  action            String
  details           Json?
  createdAt         DateTime          @default(now())

  user              User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("activity_logs")
}
